# =============================================================================
# CI-OpenClaw environment variables — example / template
# =============================================================================
# CI-OpenClaw runs as a CI-Hub marketplace app; the wrapper (server.cjs) reads
# these from the container environment. Copy to `.env` for a local run and set
# only the values you need — everything has a sensible default. When deployed
# through CI-Hub, the CI_* / APP_* values are injected automatically and you do
# not set them by hand.
# =============================================================================

# ---------------------------------------------------------------------------
# Wrapper runtime
# ---------------------------------------------------------------------------

# Directory the wrapper persists its config/state to. Default: /data/.openclaw
#OPENCLAW_DATA_DIR=/data/.openclaw

# Port the setup/wrapper HTTP server binds to. Default: 18789
#SETUP_PORT=18789

# One-time setup token that gates the first-run setup UI. Injected by CI-Hub;
# leave unset for a local run to allow open setup on loopback.
#APP_SEED=

# Auth token the wrapper uses to talk to the OpenClaw gateway. Auto-managed when
# unset; set to pin a fixed token.
#OPENCLAW_GATEWAY_TOKEN=

# ---------------------------------------------------------------------------
# Companion Memory (CI-Server) — injected by CI-Hub after the user connects
# ---------------------------------------------------------------------------
# You normally do NOT set these: the Hub's memory-connect flow injects the URL
# + minted key on every env regeneration. Set them manually only to point at an
# external CI-Server for a standalone run.

# Companion Memory (CI-Server) base URL the agent reads/writes long-term memory at.
#CI_SERVER_URL=http://localhost:3030

# Memory-scoped API key for CI_SERVER_URL (sent as x-api-key).
#CI_SERVER_TOKEN=

# ---------------------------------------------------------------------------
# Error reporting (Sentry) — opt-in, OFF by default
# ---------------------------------------------------------------------------
# Leave SENTRY_DSN unset and nothing initialises: the SDK is never loaded and the
# container makes no outbound connection. See docs/operations/error-reporting.md.
# Events go to the `ci-openclaw` Sentry project (named for the marketplace app id).

# DSN for the wrapper's error reports. Unset = reporting off.
#SENTRY_DSN=https://<key>@o<org>.ingest.us.sentry.io/<project-id>

# Environment tag on reported events. Falls back to CI_ENVIRONMENT, then
# NODE_ENV, then "development".
#SENTRY_ENV=production

# Release tag. Defaults to ci-openclaw-wrapper@$CI_OPENCLAW_VERSION when that is set.
#SENTRY_RELEASE=

# App version, also stamped on every event as the `deployment_version` tag.
#CI_OPENCLAW_VERSION=

# Kill switches. Either one disables reporting even when a DSN is configured, so
# reporting can be turned off without rebuilding the image. CI_LOCAL_ONLY wins
# over CI_TELEMETRY, which wins over the DSN.
#CI_TELEMETRY=off        # also accepts: false, 0, no, disabled
#CI_LOCAL_ONLY=true      # local-only mode = zero phone-home

# ---------------------------------------------------------------------------
# LLM providers — set the key(s) for the provider(s) you actually use
# ---------------------------------------------------------------------------

#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=
# Override the OpenAI-compatible base URL (self-hosted / proxy endpoints).
#OPENAI_API_BASE=
#GEMINI_API_KEY=
#GROQ_API_KEY=
#MISTRAL_API_KEY=
#MOONSHOT_API_KEY=
#OPENROUTER_API_KEY=
#XAI_API_KEY=
#ZAI_API_KEY=
#CEREBRAS_API_KEY=
#DASHSCOPE_API_KEY=
#MINIMAX_API_KEY=
#VENICE_API_KEY=

# Local Ollama: host URL + optional key. Default host is the appliance Ollama.
#OLLAMA_HOST=http://localhost:11434
#OLLAMA_API_KEY=

# Default model id the agent uses when a request does not specify one.
#DEFAULT_MODEL=

# Context-window (num_ctx) override for local models, in tokens. Default: model's own.
#CI_LLM_NUM_CTX=
